{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@running/engine": ["./engine/src/index.ts"]
    }
  },
  "include": ["src", "engine/src", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "engine/test"]
}
